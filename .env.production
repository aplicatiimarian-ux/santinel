# PRODUCTION ENVIRONMENT VARIABLES
# Never commit this file to git

# Database
DATABASE_URL=postgresql://postgres:CHANGE_THIS_PASSWORD@localhost:5432/santinel_prod

# Security
JWT_SECRET=your-production-secret-key-min-32-chars-change-this
JWT_ALGORITHM=HS256
TOKEN_EXPIRY_HOURS=24

# API
API_BASE_URL=https://api.santinel.io
API_PORT=8002
API_HOST=0.0.0.0

# Frontend
VITE_API_BASE=https://api.santinel.io/api/v1
VITE_APP_NAME=SANTINEL
VITE_APP_VERSION=1.0.0

# Monitoring & Logging
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
LOG_LEVEL=info
ENABLE_METRICS=true

# Email (for transactional emails)
SENDGRID_API_KEY=SG.your-sendgrid-key
SENDGRID_FROM_EMAIL=noreply@santinel.io

# Backup
BACKUP_ENABLED=true
BACKUP_SCHEDULE=daily
BACKUP_RETENTION_DAYS=30

# Rate Limiting
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_WINDOW_MINUTES=60

# CORS
ALLOWED_ORIGINS=https://santinel.io,https://www.santinel.io,https://app.santinel.io

# Analytics
PLAUSIBLE_DOMAIN=santinel.io
ANALYTICS_ENABLED=true

# Environment
ENVIRONMENT=production
DEBUG=false