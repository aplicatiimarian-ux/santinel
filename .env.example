# SANTINEL — environment template. Copy to .env and fill in real values.
# .env and .env.* are gitignored (except *.example).

# --- LLM / vector providers ---
# GROQ_API_KEY also powers live Whisper transcription in start_api.py (FAZA 23.2).
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo
MISTRAL_API_KEY=
OPENAI_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX_NAME=coaching-patterns
PINECONE_ENVIRONMENT=us-east-1
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral:7b

DATABASE_URL=sqlite:///./santinel.db
APP_NAME=SANTINEL
VERSION=3.0.0
DEBUG=false
USE_MOCK_VECTORDB=true

# --- JWT auth (start_api.py) ---
# Generate a secret:  python -c "import secrets; print(secrets.token_hex(48))"
JWT_SECRET=
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7
AUTH_DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/santinel_prod
# Comma-separated browser origins allowed to call the API (CORS).
CORS_ORIGINS=http://localhost:5173,http://192.168.1.50:5173
# true in production (HTTPS) so the refresh cookie gets the Secure flag.
AUTH_COOKIE_SECURE=false
